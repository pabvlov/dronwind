# ========================================
# Email Configuration — Resend (Recommended)
# ========================================
# Resend is a modern email API that works on any server (no SMTP ports needed).
# 1. Go to https://resend.com and create a free account
# 2. Generate an API key
# 3. Add it below. Free tier: 3,000 emails/day.
#
# To use your own domain, verify it in Resend Dashboard > Domains.
# Until verified, you can send FROM any @resend.dev address or your own domain
# (deliverability may vary until verified).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destination email for form submissions
CONTACT_EMAIL=contacto@dronwind.cl

# Sender email shown in the "From" field
# If your domain is NOT verified in Resend, use onboarding@resend.dev
# If verified, use contacto@dronwind.cl (or any address on that domain)
SMTP_FROM=contacto@dronwind.cl
