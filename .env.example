# ========================================
# SMTP Configuration — Required for email form
# ========================================

# ------------------------------------------------------------------------------
# GOOGLE WORKSPACE (Recommended)
# ------------------------------------------------------------------------------
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password (16 characters, no spaces)
# 3. Use that as SMTP_PASS — never your regular Google password
#
# NOTE: If SMTP_FROM and CONTACT_EMAIL are the same (contacto@dronwind.cl),
# Google Workspace handles it fine because the email is authenticated via SMTP.
# The "Formulario Dronwind" sender name makes it clear in your inbox.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contacto@dronwind.cl
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=contacto@dronwind.cl

# Destination email for form submissions
CONTACT_EMAIL=contacto@dronwind.cl

# ------------------------------------------------------------------------------
# ALTERNATIVE: Separate sender alias (cleaner)
# ------------------------------------------------------------------------------
# In Google Workspace Admin, create an alias like formulario@dronwind.cl
# pointing to contacto@dronwind.cl, then use:
#
# SMTP_USER=formulario@dronwind.cl
# SMTP_FROM=formulario@dronwind.cl
# CONTACT_EMAIL=contacto@dronwind.cl

# ------------------------------------------------------------------------------
# OTHER PROVIDERS (e.g. hosting SMTP)
# ------------------------------------------------------------------------------
# SMTP_HOST=mail.tudominio.cl
# SMTP_PORT=465
# SMTP_USER=contacto@dronwind.cl
# SMTP_PASS=tu_clave_segura
# SMTP_FROM=contacto@dronwind.cl
# CONTACT_EMAIL=contacto@dronwind.cl
