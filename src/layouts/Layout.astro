---
import SEO from '../components/SEO.astro';

export interface Props {
	title: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
}

const { title, description, keywords, image, canonical, noindex } = Astro.props;

const siteUrl = "https://dronwind.cl";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`) : `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="es">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4QHR7T5JXV"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-4QHR7T5JXV');
		</script>
		<SEO
			title={title}
			description={description}
			keywords={keywords}
			image={image}
			canonical={canonicalUrl}
			noindex={noindex}
		/>
		
		<!-- Structured Data - JSON-LD: LocalBusiness -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"@id": "https://dronwind.cl/#business",
			"name": "Dronwind",
			"alternateName": "Dronwind Chile",
			"description": "Servicio profesional de limpieza con drones en V Región de Chile. Especialistas en limpieza de fachadas, paneles solares, vidrios y techos industriales sin andamios y sin riesgos.",
			"url": "https://dronwind.cl",
			"logo": "https://dronwind.cl/favicon.svg",
			"image": "https://dronwind.cl/assets/images/drone-limpieza.jpeg",
			"telephone": "+56 9 5408 0730",
			"email": "contacto@dronwind.cl",
			"priceRange": "$$$",
			"currenciesAccepted": "CLP",
			"paymentAccepted": "Efectivo, Transferencia bancaria",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "",
				"addressLocality": "Viña del Mar",
				"addressRegion": "Valparaíso",
				"addressCountry": "CL",
				"postalCode": ""
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": -33.0247,
				"longitude": -71.5518
			},
			"areaServed": [
				{ "@type": "City", "name": "Viña del Mar", "containedInPlace": { "@type": "State", "name": "Valparaíso" } },
				{ "@type": "City", "name": "Valparaíso", "containedInPlace": { "@type": "State", "name": "Valparaíso" } },
				{ "@type": "City", "name": "Concón", "containedInPlace": { "@type": "State", "name": "Valparaíso" } },
				{ "@type": "City", "name": "Quilpué", "containedInPlace": { "@type": "State", "name": "Valparaíso" } },
				{ "@type": "City", "name": "Villa Alemana", "containedInPlace": { "@type": "State", "name": "Valparaíso" } },
				{ "@type": "City", "name": "Limache", "containedInPlace": { "@type": "State", "name": "Valparaíso" } }
			],
			"serviceType": [
				"Limpieza con drones",
				"Mantenimiento en altura",
				"Limpieza de fachadas",
				"Limpieza de paneles solares",
				"Limpieza industrial",
				"Limpieza de vidrios",
				"Limpieza de techos"
			],
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "Servicios de limpieza con drones",
				"itemListElement": [
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Limpieza de fachadas con drones",
							"description": "Limpieza profesional de fachadas de edificios residenciales y comerciales usando drones de alta presión."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Limpieza de paneles solares",
							"description": "Mantenimiento de paneles solares para preservar máxima eficiencia energética."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Limpieza de vidrios y curtain walls",
							"description": "Limpieza de grandes superficies vidriadas sin rastros usando tecnología de drones."
						}
					}
				]
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
					"opens": "08:00",
					"closes": "18:00"
				},
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Saturday"],
					"opens": "09:00",
					"closes": "14:00"
				}
			],
			"sameAs": [
				"https://wa.me/56954080730"
			]
		})} />

		<!-- Structured Data: WebSite (SearchAction para Sitelinks) -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"@id": "https://dronwind.cl/#website",
			"url": "https://dronwind.cl",
			"name": "Dronwind",
			"description": "Servicio profesional de limpieza con drones en V Región de Chile",
			"publisher": { "@id": "https://dronwind.cl/#business" },
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": "https://dronwind.cl/?q={search_term_string}"
				},
				"query-input": "required name=search_term_string"
			},
			"inLanguage": "es-CL"
		})} />

		<!-- Structured Data: WebPage -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebPage",
			"@id": canonicalUrl + "#webpage",
			"url": canonicalUrl,
			"name": title,
			"description": description,
			"isPartOf": { "@id": "https://dronwind.cl/#website" },
			"about": { "@id": "https://dronwind.cl/#business" },
			"inLanguage": "es-CL"
		})} />
	</head>
	<body class="min-h-screen bg-white text-gray-900 overflow-x-hidden">
		<slot />
	</body>
</html>

<style>
	@import '../styles/global.css';

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: system-ui, sans-serif;
	}
</style>
