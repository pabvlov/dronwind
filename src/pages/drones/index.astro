---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.vue';
---

<Layout 
	title="Drones de Limpieza | Dronwind - Joyance JTC10 & JTC30"
	description="Conoce nuestra flota de drones de limpieza profesional. Modelos Joyance JTC10 y JTC30 para limpieza industrial con alta presión."
>
	<Navigation transparent={false} client:load />
	
	<main class="pt-24 min-h-screen bg-gradient-to-b from-black via-red-950/30 to-black">
		<div class="container mx-auto px-6 py-16">
			<h1 class="text-4xl md:text-6xl font-bold text-center text-white mb-6">
				Nuestra Flota de Drones
			</h1>
			<p class="text-center text-gray-400 mb-16 max-w-2xl mx-auto text-lg">
				Tecnología de punta para limpieza industrial con drones
			</p>
			
			<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<!-- JTC10 Card -->
				<a href="/drones/jtc10" class="group block bg-black/70 rounded-2xl p-8 border border-red-900/30 hover:border-red-600/50 transition-all duration-300 hover:scale-[1.02]">
					<div class="text-center">
						<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-red-600 to-red-900 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-red-900/50">
							JTC
						</div>
						<h2 class="text-3xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">Joyance JTC10</h2>
						<p class="text-gray-400 mb-6">Dron de limpieza compacto y versátil</p>
						<ul class="text-left text-gray-300 space-y-2 mb-8">
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Peso: 7.4 kg
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Presión: 3,200 PSI
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Autonomía: 30-50 min
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Alcance: 100 m
							</li>
						</ul>
						<span class="inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
							Ver modelo →
						</span>
					</div>
				</a>
				
				<!-- JTC30 Card -->
				<a href="/drones/jtc30" class="group block bg-black/70 rounded-2xl p-8 border border-red-900/30 hover:border-red-600/50 transition-all duration-300 hover:scale-[1.02]">
					<div class="text-center">
						<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-red-600 to-red-900 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-red-900/50">
							JTC
						</div>
						<h2 class="text-3xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">Joyance JTC30</h2>
						<p class="text-gray-400 mb-6">Dron de limpieza industrial de alta capacidad</p>
						<ul class="text-left text-gray-300 space-y-2 mb-8">
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Peso: 24.4 kg
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Presión: 4,100 PSI
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Autonomía: 20-40 min
							</li>
							<li class="flex items-center gap-2">
								<span class="text-red-500">▸</span> Alcance: 160 m
							</li>
						</ul>
						<span class="inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
							Ver modelo →
						</span>
					</div>
				</a>
			</div>
		</div>
	</main>
</Layout>
