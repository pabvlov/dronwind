---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.vue';
import QuoteModal from '../../components/QuoteModal.vue';
---

<Layout 
	title="Drones de Limpieza | Dronwind - Joyance JTC10 & JTC30"
	description="Conoce nuestra flota de drones de limpieza profesional. Modelos Joyance JTC10 y JTC30 para limpieza industrial con alta presión."
	image="/assets/images/dron-compra.webp"
	canonical="/drones"
>
	<Navigation transparent={false} client:load />

	<!-- Breadcrumb Schema -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{
				"@type": "ListItem",
				"position": 1,
				"name": "Inicio",
				"item": "https://dronwind.cl/"
			},
			{
				"@type": "ListItem",
				"position": 2,
				"name": "Drones de Limpieza",
				"item": "https://dronwind.cl/drones"
			}
		]
	})} />

	<main class="overflow-x-hidden">
		<!-- Hero -->
		<section 
			class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden"
			style="background: linear-gradient(225deg, #b91c1c 0%, #7f1d1d 10%, #450a0a 30%, #1a0505 60%, #000000 100%);"
		>
			<div class="container mx-auto px-6 text-center relative z-10">
				<h1 
					class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight"
					style="font-family: 'Montserrat', sans-serif;"
				>
					Nuestra Flota
				</h1>
				<p class="text-gray-300 text-lg max-w-2xl mx-auto">
					Equipos profesionales Joyance listos para operar. Tecnología de punta para limpieza industrial con drones.
				</p>
			</div>
		</section>
		
		<!-- Sección de Modelos -->
		<section class="py-20 md:py-32 bg-white">
			<div class="container mx-auto px-6">
				<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
					<!-- JTC10 Card -->
					<a 
						href="/drones/jtc10" 
						class="group block bg-white rounded-2xl border border-gray-100 hover:border-red-200 hover:shadow-lg transition-all duration-300 overflow-hidden no-underline"
					>
						<div class="aspect-video bg-gray-50 flex items-center justify-center relative overflow-hidden">
							<img 
								src="/assets/images/drone.svg" 
								alt="Drone Joyance JTC10" 
								class="w-28 h-28 opacity-80 group-hover:scale-110 transition-transform duration-300"
							/>
							<div class="absolute top-4 right-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">
								Compacto
							</div>
						</div>
						<div class="p-8">
							<h2 class="text-2xl font-bold text-gray-900 mb-2 group-hover:text-red-600 transition-colors" style="font-family: 'Montserrat', sans-serif;">
								Joyance JTC10
							</h2>
							<p class="text-gray-500 mb-6">
								Dron de limpieza compacto y versátil. Ideal para fachadas, paneles solares y techos de mediana altura.
							</p>
							<ul class="space-y-3 mb-8 text-sm text-gray-600">
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">3,200 PSI</span> de presión
								</li>
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">30-50 min</span> de autonomía
								</li>
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">100 m</span> de alcance
								</li>
							</ul>
							<span class="inline-flex items-center text-red-600 font-semibold group-hover:text-red-700 transition-colors">
								Ver modelo
								<svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
								</svg>
							</span>
						</div>
					</a>
					
					<!-- JTC30 Card -->
					<a 
						href="/drones/jtc30" 
						class="group block bg-white rounded-2xl border border-gray-100 hover:border-red-200 hover:shadow-lg transition-all duration-300 overflow-hidden no-underline"
					>
						<div class="aspect-video bg-gray-50 flex items-center justify-center relative overflow-hidden">
							<img 
								src="/assets/images/drone.svg" 
								alt="Drone Joyance JTC30" 
								class="w-32 h-32 opacity-80 group-hover:scale-110 transition-transform duration-300"
							/>
							<div class="absolute top-4 right-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">
								Industrial
							</div>
						</div>
						<div class="p-8">
							<h2 class="text-2xl font-bold text-gray-900 mb-2 group-hover:text-red-600 transition-colors" style="font-family: 'Montserrat', sans-serif;">
								Joyance JTC30
							</h2>
							<p class="text-gray-500 mb-6">
								Dron de limpieza industrial de alta capacidad. Diseñado para edificios altos y grandes superficies.
							</p>
							<ul class="space-y-3 mb-8 text-sm text-gray-600">
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">4,100 PSI</span> de presión
								</li>
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">20-40 min</span> de autonomía
								</li>
								<li class="flex items-center gap-3">
									<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span class="font-medium text-gray-900">160 m</span> de alcance
								</li>
							</ul>
							<span class="inline-flex items-center text-red-600 font-semibold group-hover:text-red-700 transition-colors">
								Ver modelo
								<svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
								</svg>
							</span>
						</div>
					</a>
				</div>
			</div>
		</section>
		
		<!-- CTA Final -->
		<section class="py-20 md:py-32 bg-gray-50">
			<div class="container mx-auto px-6 text-center">
				<h2 
					class="text-4xl md:text-6xl font-black text-gray-900 mb-6"
					style="font-family: 'Montserrat', sans-serif;"
				>
					¿Necesitas asesoría?
				</h2>
				<p class="text-gray-500 text-lg mb-10 max-w-xl mx-auto">
					Te ayudamos a elegir el modelo ideal para tu proyecto. Cotiza sin compromiso.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<QuoteModal model="Drones de limpieza Dronwind" client:visible>
					<button
						type="button"
						class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold text-lg px-10 py-5 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl cursor-pointer border-0"
					>
						Cotizar limpieza
					</button>
				</QuoteModal>
					<a 
						href="/"
						class="inline-block bg-gray-900 hover:bg-gray-800 text-white font-bold text-lg px-10 py-5 rounded-xl transition-all duration-300 hover:scale-105 no-underline"
					>
						Volver al inicio
					</a>
				</div>
			</div>
		</section>
		
		<!-- Footer -->
		<footer class="py-8 bg-gray-900 text-gray-400 text-center text-sm">
			<div class="container mx-auto px-6">
				<p>Hecho por <a href="https://granpasochile.cl" target="_blank" rel="noopener noreferrer" class="text-red-500 hover:text-red-400 transition-colors font-semibold no-underline">Gran Paso</a></p>
			</div>
		</footer>
	</main>
</Layout>
