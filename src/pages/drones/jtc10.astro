---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.vue';
---

<Layout 
	title="Joyance JTC10 - Dron de Limpieza | Dronwind"
	description="Dron Joyance JTC10 para limpieza profesional. Peso 7.4 kg, presión 3,200 PSI, autonomía 30-50 minutos. Ideal para fachadas, paneles solares y techos."
>
	<Navigation transparent={false} client:load />
	
	<main class="pt-24 min-h-screen bg-gradient-to-b from-black via-red-950/20 to-black">
		<div class="container mx-auto px-6 py-16">
			<!-- Breadcrumb -->
			<div class="mb-8">
				<a href="/drones" class="text-red-400 hover:text-red-300 transition-colors">← Volver a Drones</a>
			</div>
			
			<div class="max-w-4xl mx-auto">
				<h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
					Dron Joyance JTC10
				</h1>
				<p class="text-xl text-gray-400 mb-12">
					Dron de limpieza a alta presión — versátil y eficiente
				</p>
				
				<!-- Placeholder para contenido del modelo -->
				<div class="bg-black/50 rounded-2xl p-8 border border-red-900/30 mb-12">
					<h2 class="text-2xl font-bold text-white mb-6">Especificaciones Técnicas</h2>
					<div class="grid md:grid-cols-2 gap-6">
						<div class="space-y-4">
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Peso propio (sin batería)</span>
								<span class="text-white font-semibold">7.4 kg</span>
							</div>
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Presión de bomba</span>
								<span class="text-white font-semibold">3,200 PSI</span>
							</div>
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Eficiencia de pulverización</span>
								<span class="text-white font-semibold">1,000 m²/hora</span>
							</div>
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Caudal</span>
								<span class="text-white font-semibold">0-12 l/min</span>
							</div>
						</div>
						<div class="space-y-4">
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Tiempo de vuelo</span>
								<span class="text-white font-semibold">30-50 minutos</span>
							</div>
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Altura de vuelo</span>
								<span class="text-white font-semibold">100 m</span>
							</div>
							<div class="flex justify-between border-b border-red-900/20 pb-2">
								<span class="text-gray-400">Batería</span>
								<span class="text-white font-semibold">12S 32,000 mAh</span>
							</div>
						</div>
					</div>
				</div>
				
				<div class="bg-black/50 rounded-2xl p-8 border border-red-900/30">
					<h2 class="text-2xl font-bold text-white mb-4">Kit Estándar</h2>
					<p class="text-gray-400">
						Incluye control remoto MK15 con cámara FPV, bomba eléctrica de alta presión (potencia 5kW), 
						switch semiautomático de agua (20,000 m³/h), cargador, manguera de agua antiaplastante de 100m, 
						y estuche de transporte de aluminio.
					</p>
				</div>
				
				<div class="mt-12 text-center">
					<p class="text-gray-500 italic">Diseño visual del modelo en desarrollo</p>
				</div>
			</div>
		</div>
	</main>
</Layout>
