---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.vue';
import QuoteForm from '../../components/QuoteForm.vue';
---

<Layout 
	title="Joyance JTC30 - Dron de Limpieza Industrial | Dronwind"
	description="Dron Joyance JTC30 para limpieza industrial de gran escala. Peso 24.4 kg, presión 4,100 PSI, autonomía 20-40 minutos. Ideal para edificios altos y grandes superficies."
	image="/assets/images/jtc30-ficha.jpeg"
	canonical="/drones/jtc30"
>
	<Navigation transparent={false} client:load />

	<!-- Breadcrumb Schema -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{
				"@type": "ListItem",
				"position": 1,
				"name": "Inicio",
				"item": "https://dronwind.cl/"
			},
			{
				"@type": "ListItem",
				"position": 2,
				"name": "Drones de Limpieza",
				"item": "https://dronwind.cl/drones"
			},
			{
				"@type": "ListItem",
				"position": 3,
				"name": "Joyance JTC30",
				"item": "https://dronwind.cl/drones/jtc30"
			}
		]
	})} />

	<main class="overflow-x-hidden">
		<!-- Hero Banner -->
		<section class="relative w-full h-[70vh] md:h-[80vh] bg-black overflow-hidden">
			<!-- Drone Image as background -->
			<img 
				src="/assets/images/jtc30-banner.webp" 
				alt="Joyance JTC30 - Drone de limpieza industrial"
				class="absolute inset-0 w-full h-full object-cover"
			/>
			<!-- Dark gradient overlay for text legibility -->
			<div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent" />
			<!-- Text content -->
			<div class="absolute bottom-0 left-0 right-0">
				<div class="[width:auto] m-[10%] md:m-4 pb-12 md:pb-16">
					<div class="max-w-4xl mx-auto">
						<!-- Breadcrumb -->
						<div class="mb-4">
							<a href="/drones" class="text-red-500 hover:text-red-400 transition-colors text-sm font-medium no-underline">
								← Volver a Drones
							</a>
						</div>
						<h1 
							class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight"
							style="font-family: 'Montserrat', sans-serif;"
						>
							Joyance JTC3<span class="text-red-600">0</span>
						</h1>
						<p class="text-xl md:text-2xl text-gray-300 max-w-2xl">
							Dron de limpieza a alta presión — máxima potencia industrial.
						</p>
					</div>
				</div>
			</div>
		</section>
		
		<!-- Especificaciones -->
		<section class="py-20 md:py-28 bg-white">
			<div class="[width:auto] m-[10%] md:m-4">
				<div class="max-w-4xl mx-auto">
					<h2 
						class="text-3xl md:text-4xl font-black text-gray-900 mb-10 text-center"
						style="font-family: 'Montserrat', sans-serif;"
					>
						Especificaciones Técni<span class="text-red-600">c</span>as
					</h2>
					
					<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-10">
						<div class="grid md:grid-cols-2 gap-x-12 gap-y-6">
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Peso propio (sin batería)</span>
								<span class="text-gray-900 font-semibold">24.4 kg</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Presión de bomba</span>
								<span class="text-gray-900 font-semibold">4,100 PSI</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Eficiencia de pulverización</span>
								<span class="text-gray-900 font-semibold">1,500-2,000 m²/hora</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Caudal</span>
								<span class="text-gray-900 font-semibold">0-15 l/min</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Tiempo de vuelo</span>
								<span class="text-gray-900 font-semibold">20-40 minutos</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Altura de vuelo</span>
								<span class="text-gray-900 font-semibold">160 m</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Batería</span>
								<span class="text-gray-900 font-semibold">2× 14S 36,000 mAh</span>
							</div>
							<div class="flex justify-between items-center border-b border-gray-100 pb-4">
								<span class="text-gray-500">Alcance</span>
								<span class="text-gray-900 font-semibold">160 m</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		
		<!-- Kit Estándar -->
		<section class="py-20 md:py-28 bg-gray-50">
			<div class="[width:auto] m-[10%] md:m-4">
				<div class="max-w-4xl mx-auto">
					<h2 
						class="text-3xl md:text-4xl font-black text-gray-900 mb-10 text-center"
						style="font-family: 'Montserrat', sans-serif;"
					>
						Kit Estánda<span class="text-red-600">r</span>
					</h2>
					<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-10">
						<p class="text-gray-600 leading-relaxed">
							Incluye control remoto MK15 con cámara FPV e impermeable con ángulo ajustable, bomba eléctrica de alta presión, 
							2 baterías semisólidas 14S de 36,000 mAh, cargador, manguera de agua antiaplastante de 100m con boquilla multijet, 
							y estuche de transporte de aluminio.
						</p>
					</div>
				</div>
			</div>
		</section>
		
		<!-- Ficha Técnica -->
		<section class="py-20 md:py-28 bg-white">
			<div class="[width:auto] m-[10%] md:m-4">
				<div class="max-w-4xl mx-auto">
					<h2 
						class="text-3xl md:text-4xl font-black text-gray-900 mb-10 text-center"
						style="font-family: 'Montserrat', sans-serif;"
					>
						Ficha Técni<span class="text-red-600">c</span>a
					</h2>
					<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 md:p-6">
						<img 
							src="/assets/images/jtc30-attachments.webp" 
							alt="Kit estándar Joyance JTC30 - Control remoto, baterías, bomba, manguera y accesorios"
							class="w-full h-auto rounded-xl"
						/>
					</div>
				</div>
			</div>
		</section>
		
		<!-- Formulario de Cotización -->
		<QuoteForm model="Joyance JTC30" client:visible />
		
		<!-- CTA -->
		<section class="py-20 md:py-28 bg-white">
			<div class="[width:auto] m-[10%] md:m-4 text-center">
				<h2 
					class="text-3xl md:text-5xl font-black text-gray-900 mb-6"
					style="font-family: 'Montserrat', sans-serif;"
				>
					¿Interesado en el JTC3<span class="text-red-600">0</span>?
				</h2>
				<p class="text-gray-500 text-lg mb-10 max-w-xl mx-auto">
					Consulta por disponibilidad, precios y financiamiento.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a 
						href="https://wa.me/56954080730" 
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold text-lg px-10 py-5 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl no-underline border-0"
					>
						Cotizar por WhatsApp
					</a>
					<a 
						href="/drones"
						class="inline-block bg-gray-900 hover:bg-gray-800 text-white font-bold text-lg px-10 py-5 rounded-xl transition-all duration-300 hover:scale-105 no-underline"
					>
						Ver todos los modelos
					</a>
				</div>
			</div>
		</section>
		
		<!-- Footer -->
		<footer class="py-8 bg-gray-900 text-gray-400 text-center text-sm">
			<div class="[width:auto] m-[10%] md:m-4">
				<p>Hecho por <a href="https://granpasochile.cl" target="_blank" rel="noopener noreferrer" class="text-red-500 hover:text-red-400 transition-colors font-semibold no-underline">Gran Paso</a></p>
			</div>
		</footer>
	</main>
</Layout>
