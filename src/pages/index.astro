---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.vue';
import HeroSection from '../components/HeroSection.vue';
import AnimatedCard from '../components/AnimatedCard.vue';
---

<Layout title="Dronwind - Empresa de limpieza con drones">
	<!-- Navegación -->
	<Navigation transparent={true} client:load />
	
	<main>
		<!-- Hero Section -->
		<HeroSection 
			title="DRONWIND"
			subtitle="No importa la altura, importa el riesgo que evitas."
			client:load
		/>
		
		<!-- Cards Section -->
		<section class="py-20 relative" style="background: linear-gradient(180deg, #000000 0%, #1a0505 20%, #450a0a 40%, #7f1d1d 60%, #450a0a 80%, #000000 100%);">
			<div class="container mx-auto px-6 relative z-10">
				<h2 class="text-3xl font-bold text-center text-white mb-12 drop-shadow-lg">
					Características del Proyecto
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
					<AnimatedCard
						title="Astro Framework"
						description="Framework moderno para sitios web rápidos con componentes múltiples frameworks."
						buttonText="Explorar Astro"
						delay={0.1}
						client:visible
					/>
					
					<AnimatedCard
						title="Vue Integration"
						description="Componentes reactivos de Vue perfectamente integrados con Astro."
						buttonText="Ver Vue"
						delay={0.2}
						client:visible
					/>
					
					<AnimatedCard
						title="Tailwind CSS"
						description="Estilos utility-first para un desarrollo rápido y consistente."
						buttonText="Diseñar"
						delay={0.3}
						client:visible
					/>
					
					<AnimatedCard
						title="GSAP Animations"
						description="Animaciones profesionales y fluidas con la librería líder del mercado."
						buttonText="Animar"
						delay={0.4}
						client:visible
					/>
					
					<AnimatedCard
						title="SSR Ready"
						description="Renderizado del lado del servidor para mejor SEO y rendimiento."
						buttonText="Optimizar"
						delay={0.5}
						client:visible
					/>
					
					<AnimatedCard
						title="TypeScript"
						description="Tipado estático para un desarrollo más seguro y productivo."
						buttonText="Codificar"
						delay={0.6}
						client:visible
					/>
				</div>
			</div>
		</section>
		
		<!-- Footer -->
		<footer class="relative py-12" style="background: linear-gradient(180deg, #000000 0%, #1a0505 50%, #000000 100%);">
			<div class="container mx-auto px-6 text-center relative z-10">
				<h3 class="text-xl font-semibold mb-4 text-white">Proyecto Dronwind</h3>
				<p class="text-gray-300 mb-6">
					Construido con las mejores tecnologías modernas para desarrollo web.
				</p>
				<div class="flex justify-center space-x-6">
					<a href="#" class="text-red-400 hover:text-red-300 transition-colors">
						Documentación
					</a>
					<a href="#" class="text-red-400 hover:text-red-300 transition-colors">
						GitHub
					</a>
					<a href="#" class="text-red-400 hover:text-red-300 transition-colors">
						Soporte
					</a>
				</div>
			</div>
			
			<!-- Botón de WhatsApp flotante -->
			<a 
				href="https://wa.me/56954080730" 
				target="_blank"
				rel="noopener noreferrer"
				class="fixed bottom-6 right-52 z-50 bg-green-600 hover:bg-green-700 backdrop-blur-md rounded-full p-3 shadow-xl transition-all duration-300 hover:scale-110 group"
				aria-label="Contactar por WhatsApp"
			>
				<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
				</svg>
				<span class="absolute -top-1 -right-1 w-3 h-3 bg-green-400 rounded-full animate-ping"></span>
				<span class="absolute -top-1 -right-1 w-3 h-3 bg-green-400 rounded-full"></span>
			</a>
			
			<!-- Ubicación flotante -->
			<div class="fixed bottom-6 right-6 z-50 bg-black/60 backdrop-blur-md border border-red-900/40 rounded-lg px-3 py-2 shadow-xl hover:border-red-700/60 transition-all duration-300 hover:scale-105">
				<div class="flex items-center gap-2 whitespace-nowrap">
					<svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
					</svg>
					<p class="text-white font-semibold text-sm">Viña del Mar, Chile</p>
				</div>
			</div>
		</footer>
	</main>
</Layout>
